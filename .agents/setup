#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."

export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"

profile_marker="# sur33-blog orb toolchain"
if ! grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<'EOF'

# sur33-blog orb toolchain
export PNPM_HOME="$HOME/.local/share/pnpm"
export PATH="$PNPM_HOME/bin:$PATH"
EOF
fi

# pnpm と Node.js のバージョンは package.json が持つ。
# `packageManager` に従って pnpm 自身が切り替わり、`pnpm install` が
# `devEngines.runtime` の Node.js を導入して `pnpm run` の実行環境にする。
pnpm install --frozen-lockfile

sudo apt-get update
sudo apt-get install -y fonts-noto-cjk
pnpm exec playwright install --with-deps chromium firefox webkit
