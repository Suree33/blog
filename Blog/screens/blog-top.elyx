// 2024-07-31 — tags: ガジェット / PC
rowIntel = frame : controls.postItem {
  overrides: [remove(controls.thumb)],

  controls.postContent {
    width: lengthTokens.lengths.post-content-full,

    controls.postDescription {
      contents: "Intel Core 第13/14世代プロセッサに関する不具合により、ゲームが頻繁にクラッシュする問題に関して、試したことやIntelのサポートとのやり取りをまとめました。"
    }

    controls.postTitle {
      contents: "Intel Core i5-13600KFでゲームがクラッシュする問題"
    }

    controls.postMeta {
      controls.metaDate {
        contents: "2024年7月31日"
      }

      controls.metaTag2 {
        contents: "PC"
      }
    }
  }
}

// 2024-04-15 — tags: アプリ / Obsidian — ogimage thumbnail (base content)
rowObsidian = frame : controls.postItem {}

pageFooter = frame : footerBlock.siteFooter {}
