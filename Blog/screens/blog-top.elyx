import "tokens/colors.elyx" as colorTokens
import "tokens/lengths.elyx" as lengthTokens
import "blocks/site-header.elyx" as headerBlock
import "blocks/site-footer.elyx" as footerBlock
import "controls/post-item.elyx" as postItems

// index.astro: every non-draft post, newest pubDate first, no pagination.
blogTop = frame {
  left: 0px,
  top: 0px,
  width: lengthTokens.lengths.screen-width,
  height: .auto,
  layout: {direction: .column, align-items: .stretch},
  fill: colorTokens.colors.background,
  children: [pageHeader, pageMain, pageFooter]
}

// The same page with the theme=dark context applied to the whole screen.
@with-context(theme="dark")
blogTopDark = frame : blogTop {
  left: 1540px,
  top: 0px,

  @use-variant(headerBlock.darkThemeSiteHeader)
  pageHeader {}
}

pageHeader = frame : headerBlock.siteHeader {}

// mt-10 above the list; the footer's mt-12 is folded into the bottom padding.
pageMain = frame {
  height: .auto,
  layout: {direction: .column, align-items: .center},
  padding-top: lengthTokens.lengths.main-pad-top,
  padding-bottom: lengthTokens.lengths.footer-margin-top,
  children: postList
}

postList = frame {
  width: lengthTokens.lengths.page-max,
  height: .auto,
  layout: {direction: .column, item-gap: lengthTokens.lengths.list-gap},
  children: [
    rowNespressoMold,
    rowZshrcStartupSlowCauseAndFix,
    rowResolveSidekickNvimCodexSearchError,
    rowRemarkLinkCardPlus,
    rowKeyboardSettingsTips,
    rowCatppuccinCoteditor,
    rowTailscaleGithubActionsToDeployPalworldServerDocker,
    rowIntelCoreI513600kfGameCrash,
    rowNatureRemoLapis,
    rowAudioInterfaceUnderTheDesk,
    rowWishlist202404,
    rowSetupObsidianLivesync,
    rowPerplexityProIsCheaperOnIosApp,
    rowRemarkLinkCardWithAstro,
    rowLogiMxMasterIsBetterThanLift,
    rowFanForMyRightHand
  ]
}

