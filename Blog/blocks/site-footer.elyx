import "tokens/colors.elyx" as colorTokens
import "tokens/lengths.elyx" as lengthTokens
import "tokens/numbers.elyx" as numberTokens
import "tokens/fonts.elyx" as fontTokens
import "controls/footer-nav-item.elyx" as footerNavItems
import "resources/icons/github.svg" as githubGlyph
import "resources/icons/x.svg" as xGlyph
import "resources/icons/instagram.svg" as instagramGlyph
import "resources/icons/rss.svg" as rssGlyph

// Footer.astro at sm+: a full-width top border around a `container px-4` row.
// The border is a 1px layer so it adds to the height as CSS border-top does.
export siteFooter = frame {
  left: 0px,
  top: 0px,
  width: lengthTokens.lengths.screen-width,
  height: .auto,
  layout: {direction: .column, align-items: .center},
  children: [footerDivider, footerBar]
}

footerDivider = frame {
  width: 100%,
  height: lengthTokens.lengths.divider-width,
  fill: colorTokens.colors.divider
}

// Footer.astro inlines its icon links: text-lg glyphs in the subtle color.
export footerIcon = icon {
  left: 0px,
  top: 160px,
  width: lengthTokens.lengths.icon-footer,
  height: lengthTokens.lengths.icon-footer,
  fill: colorTokens.colors.content-subtle,
  contents: githubGlyph
}

footerBar = frame {
  width: lengthTokens.lengths.page-max,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  padding: [
    lengthTokens.lengths.footer-pad-y,
    lengthTokens.lengths.screen-pad-x
  ],
  children: [footerSiteName, footerNav, footerIcons]
}

footerSiteName = text {
  fill: colorTokens.colors.content-primary,
  contents: "Daiki Sato",
  font-size: numberTokens.numbers.font-xl,
  font-family: fontTokens.fonts.latin-display,
  font-style: fontTokens.fonts.latin-semibold,
  line-height: numberTokens.numbers.leading-xl,
  letter-spacing: numberTokens.numbers.tracking-display
}

footerNav = frame {
  height: .auto,
  layout: {align-items: .center, item-gap: lengthTokens.lengths.footer-gap},
  children: [footerNavBlog, footerNavAbout]
}

footerNavBlog = text : footerNavItems.activeFooterNavItem {}

footerNavAbout = text : footerNavItems.footerNavItem {}

footerIcons = frame {
  height: .auto,
  layout: {align-items: .center, item-gap: lengthTokens.lengths.footer-icon-gap},
  children: [footerIconX, footerIconInstagram, footerIconGithub, footerIconRss]
}

footerIconX = icon : footerIcon {
  contents: xGlyph
}

// fa6 glyphs keep their viewBox ratio: 448/512 and 496/512 of the 18px height.
footerIconInstagram = icon : footerIcon {
  width: 15.75px,
  contents: instagramGlyph
}

footerIconGithub = icon : footerIcon {
  width: 17.4375px,
  contents: githubGlyph
}

footerIconRss = icon : footerIcon {
  width: 15.75px,
  contents: rssGlyph
}
