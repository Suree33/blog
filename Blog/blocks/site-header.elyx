import "tokens/colors.elyx" as colorTokens
import "tokens/lengths.elyx" as lengthTokens
import "controls/header-nav-item.elyx" as headerNav
import "controls/header-icon.elyx" as headerIcons
import "resources/icons/github.svg" as githubGlyph
import "resources/images/profile-icon.jpg" as profilePhoto
import "resources/icons/x.svg" as xGlyph
import "resources/icons/instagram.svg" as instagramGlyph
import "resources/icons/sun.svg" as sunGlyph
import "resources/icons/moon.svg" as moonGlyph

// Header.astro at sm+: translucent sticky bar with avatar, nav, and icon links.
export siteHeader = frame {
  left: 0px,
  top: 0px,
  width: lengthTokens.lengths.screen-width,
  height: .auto,
  layout: {justify-content: .center, align-items: .center},
  fill: {color: colorTokens.colors.background, opacity: 0.8},
  padding: [
    lengthTokens.lengths.header-pad-y,
    lengthTokens.lengths.screen-pad-x
  ],
  children: headerBar
}

// ThemeToggle.astro shows lucide:moon once the dark theme is chosen; the base
// shows lucide:sun for the light theme.
@variant
export darkThemeSiteHeader = frame : siteHeader {
  left: 0px,
  top: 120px,

  headerBar {
    headerActions {
      actionTheme {
        headerIcons.headerGlyph {
          contents: moonGlyph
        }
      }
    }
  }
}

headerBar = frame {
  width: lengthTokens.lengths.page-max,
  height: .auto,
  layout: {justify-content: .space-between, align-items: .center},
  children: [headerLeft, headerActions]
}

headerLeft = frame {
  height: .auto,
  layout: {align-items: .center, item-gap: lengthTokens.lengths.header-left-gap},
  children: [headerAvatar, headerNavLinks]
}

headerAvatar = frame {
  width: lengthTokens.lengths.avatar,
  height: lengthTokens.lengths.avatar,
  fill: {image: {ref: profilePhoto}},
  border: colorTokens.colors.content-primary,
  corner-radius: lengthTokens.lengths.radius-full
}

headerNavLinks = frame {
  height: .auto,
  layout: {align-items: .center, item-gap: lengthTokens.lengths.nav-gap},
  children: [navBlog, navAbout]
}

navBlog = frame : headerNav.activeHeaderNavItem {}

navAbout = frame : headerNav.headerNavItem {
  headerNav.navLabel {
    contents: "ABOUT"
  }
}

headerActions = frame {
  height: .auto,
  layout: {align-items: .center, item-gap: lengthTokens.lengths.header-icon-gap},
  children: [actionX, actionInstagram, actionGithub, actionTheme]
}

actionX = frame : headerIcons.headerIcon {
  headerIcons.headerGlyph {
    contents: xGlyph
  }
}

// fa6 glyphs keep their viewBox ratio: instagram 448/512, github 496/512.
actionInstagram = frame : headerIcons.headerIcon {
  headerIcons.headerGlyph {
    width: 17.5px,
    contents: instagramGlyph
  }
}

actionGithub = frame : headerIcons.headerIcon {
  headerIcons.headerGlyph {
    width: 19.375px,
    contents: githubGlyph
  }
}

actionTheme = frame : headerIcons.headerIcon {
  headerIcons.headerGlyph {
    contents: sunGlyph
  }
}
